# Frontend: Convex deployment URL, injected at build time.
# - Local dev: filled automatically by `bunx convex dev` (or copy it from the CLI output).
# - Vercel: `bunx convex deploy` (in the build command) injects it for you —
#   no need to define it in the Vercel dashboard.
VITE_CONVEX_URL=

# Convex site URL for auth (redirect origin). Local dev value:
CONVEX_SITE_URL=http://localhost:5173
# In production, set it on the Convex deployment to your final domain:
#   bunx convex env set CONVEX_SITE_URL https://your-domain.com

# Deployment used by the Convex CLI (optional — usually inferred)
CONVEX_DEPLOYMENT=
